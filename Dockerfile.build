# syntax=docker/dockerfile:1.7

FROM golang:1.22.5-bookworm

ARG DEBIAN_FRONTEND=noninteractive
ARG ZIG_VERSION=0.16.0
ARG ZIG_X86_64_LINUX_SHA256=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ARG ZLIB_VERSION=1.3.2
ARG ZLIB_TAR_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16
ARG TAGLIB_VERSION=2.3
ARG TAGLIB_COMMIT=1b94b93762636ebe5733180c3e825be4621e4c7f

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    cmake \
    curl \
    file \
    g++ \
    git \
    make \
    ninja-build \
    pkg-config \
    python3 \
    unzip \
    xz-utils \
    zip \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSLo /tmp/zig.tar.xz "https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz" \
  && echo "${ZIG_X86_64_LINUX_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - \
  && tar -xJf /tmp/zig.tar.xz -C /opt \
  && ln -s "/opt/zig-x86_64-linux-${ZIG_VERSION}/zig" /usr/local/bin/zig \
  && rm /tmp/zig.tar.xz \
  && zig version

RUN mkdir -p /opt/src \
  && curl -fsSLo /tmp/zlib.tar.gz "https://zlib.net/zlib-${ZLIB_VERSION}.tar.gz" \
  && echo "${ZLIB_TAR_SHA256}  /tmp/zlib.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/zlib.tar.gz -C /opt/src \
  && mv "/opt/src/zlib-${ZLIB_VERSION}" /opt/src/zlib \
  && rm /tmp/zlib.tar.gz

RUN git clone --depth 1 --branch "v${TAGLIB_VERSION}" --recurse-submodules --shallow-submodules https://github.com/taglib/taglib.git /opt/src/taglib \
  && test "$(git -C /opt/src/taglib rev-parse HEAD)" = "${TAGLIB_COMMIT}" \
  && rm -rf /opt/src/taglib/.git

COPY scripts/docker-builder-entrypoint.sh /usr/local/bin/beatportdl-builder
RUN chmod +x /usr/local/bin/beatportdl-builder

WORKDIR /workspace

ENV GOCACHE=/tmp/go-cache

ENTRYPOINT ["/usr/local/bin/beatportdl-builder"]
